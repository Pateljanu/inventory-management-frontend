# Copy to .env.local and adjust. Only VITE_* variables reach the browser bundle,
# so never put secrets here.

# Backend base URL used by the browser. Leave the default in development: Vite
# proxies /api to VITE_DEV_API_TARGET. For a production build served from a
# different origin, set the full URL (and add that origin to the backend's CORS_ORIGINS).
VITE_API_BASE_URL=/api/v1

# Where the dev server proxies /api (the backend's PORT, default 4000).
VITE_DEV_API_TARGET=http://localhost:4000

# Calendar that defines "today" for date defaults; must match the backend's BUSINESS_TIMEZONE.
VITE_BUSINESS_TIMEZONE=Asia/Kolkata
